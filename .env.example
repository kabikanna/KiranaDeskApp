HOST=127.0.0.1
PORT=3000
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# Exact public URL configured in Twilio, including any query string.
TWILIO_WEBHOOK_URL=https://your-ngrok-domain.ngrok-free.app/api/whatsapp/incoming
# The Twilio WhatsApp number that customers message and that sends every reply.
# While testing with the Twilio Sandbox, use the Sandbox number.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# The seller's OWN WhatsApp number (not the Twilio number). Messages from this number are
# seller commands such as `/reply ORD001 Your order is being packed.`, never customer orders.
# Optional: leave empty to disable /reply. While testing, this phone must also have joined the Sandbox.
SELLER_WHATSAPP_NUMBER=
# Optional JSON file where orders, customers and conversation messages are stored (default: data/orders.json).
ORDER_STORE_PATH=data/orders.json
# Optional directory where customers' payment screenshots are saved (default: data/payment-proofs).
PAYMENT_PROOF_DIR=data/payment-proofs
# Optional JSON price list used to calculate order totals, e.g. {"rice":{"unit":"kg","price":60}}.
# Names are lowercase; units are kg, g, l, ml, pcs, ... Without it the total is "To be confirmed by the seller".
PRODUCT_PRICES_PATH=
# Static payment QR image sent after the customer replies YES. Use ONE of the two options:
# a public HTTPS image URL ...
STATIC_PAYMENT_QR_URL=
# ... or a local PNG/JPEG (max 5 MB), e.g. assets/paytm-qr.png, served at
# <TWILIO_WEBHOOK_URL origin>/payments/paytm-qr so Twilio can fetch it.
PAYTM_QR_PATH=
# Optional: generate a separate random token with `openssl rand -hex 32` to enable manual replies.
WHATSAPP_REPLY_API_TOKEN=
# Fixed customer number for `npm run reply`, e.g. whatsapp:+15551234567, not the Sandbox sender.
# Set this in .env; .env.example is not loaded by the application.
WHATSAPP_REPLY_TO=
# Optional Azure OpenAI order refinement: fixes Tamil/Tanglish/English spelling and speech mistakes before
# the order summary is sent. Set both endpoint and key to enable; otherwise the rule-based parser is used.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
